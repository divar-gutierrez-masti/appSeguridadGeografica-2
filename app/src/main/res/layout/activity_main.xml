<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <!-- Application Title -->

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Geolocation Status -->

    <TextView
        android:id="@+id/statusTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#836305"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/location_status_initializing"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleTextView" />

    <!-- Botón para solicitar permisos e INICIAR la Geocerca -->

    <Button
        android:id="@+id/requestPermissionsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1465A2"
        android:paddingVertical="14dp"
        android:text="@string/request_permissions_button"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusTextView" />

    <!-- Data Input/Output Field -->

    <EditText
        android:id="@+id/secretDataEditText"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        android:hint="@string/secret_data_hint"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:padding="10dp"
        android:background="@android:color/white"
        android:elevation="3dp"
        android:shadowColor="#33000000"
        android:shadowDy="2"
        android:shadowRadius="3"
        android:autofillHints=""
        app:layout_constraintTop_toBottomOf="@+id/requestPermissionsButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo para mostrar el IV -->

    <TextView
        android:id="@+id/ivDisplayTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="@string/iv_placeholder"
        android:textColor="#1D1D1D"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/secretDataEditText" />

    <!-- Encrypt Button -->

    <Button
        android:id="@+id/encryptButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#026259"
        android:paddingVertical="14dp"
        android:text="@string/encrypt_button"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivDisplayTextView" />

    <!-- Decrypt Button (Geofence Controlled) -->

    <Button
        android:id="@+id/decryptButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#FF5722"
        android:enabled="true"
        android:paddingVertical="14dp"
        android:text="@string/decrypt_button"
        android:textColor="@android:color/white"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/encryptButton" />

    <!-- Informational Note (Thesis Reference) -->

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/decrypt_button_info"
        android:textSize="12sp"
        android:textColor="#666666"
        android:gravity="center"
        android:paddingTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
